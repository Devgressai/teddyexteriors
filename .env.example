# Copy this to .env.local (which is gitignored) and fill in real values.
# Never commit real keys. Vars starting with NEXT_PUBLIC_ are exposed to the browser bundle —
# never put a secret in one of those.

# ─── Build gate escape hatch ──────────────────────────────────────────────
# Set to "1" to let production builds succeed while required business fields
# are still unresolved. All runtime noindex guards remain active (robots.ts
# disallows everything, every page gets noindex, sitemap stays empty, preview
# banner shows). REMOVE this flag before launching the real domain.
TEDDY_ALLOW_PREVIEW_BUILD=

# ─── Lead ops ─────────────────────────────────────────────────────────────
# Sandbox destination for form QA before the real CRM is wired.
LEAD_SANDBOX_EMAIL=

# ─── Google AI Studio (Gemini) ────────────────────────────────────────────
# Used server-side only — for build-time content tooling or server actions.
# Do NOT prefix with NEXT_PUBLIC_. Rotate if ever committed.
GOOGLE_AI_API_KEY=

# ─── Analytics / Search Console ───────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=
GOOGLE_SITE_VERIFICATION=

# ─── Optional CRM / outbound ──────────────────────────────────────────────
RESEND_API_KEY=
HUBSPOT_API_KEY=
